{
  "name": "auth-kit",
  "version": "0.1.8-alpha",
  "description": "Shared login and authorization for David Yokum's Amplify sites (passkey-first Cognito, server-side checks, admin module, localhost kit)",
  "license": "MIT",
  "author": "David Yokum",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidyokum/auth-kit.git"
  },
  "homepage": "https://github.com/davidyokum/auth-kit#readme",
  "bugs": "https://github.com/davidyokum/auth-kit/issues",
  "keywords": [
    "cognito",
    "amplify",
    "passkeys",
    "webauthn",
    "nextjs",
    "authorization",
    "generative-art"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    "./amplify": {
      "types": "./dist/amplify/index.d.ts",
      "import": "./dist/amplify/index.js"
    },
    "./amplify/pre-sign-up": {
      "types": "./dist/amplify/pre-sign-up.d.ts",
      "import": "./dist/amplify/pre-sign-up.js"
    },
    "./amplify/custom-message": {
      "types": "./dist/amplify/custom-message.d.ts",
      "import": "./dist/amplify/custom-message.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./proxy": {
      "types": "./dist/proxy/index.d.ts",
      "import": "./dist/proxy/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./testing/matrix-server": {
      "types": "./dist/testing/matrix-server.d.ts",
      "import": "./dist/testing/matrix-server.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "import": "./dist/admin/index.js"
    },
    "./admin/ui": {
      "types": "./dist/admin/ui.d.ts",
      "import": "./dist/admin/ui.js"
    },
    "./admin/cdk": {
      "types": "./dist/admin/cdk.d.ts",
      "import": "./dist/admin/cdk.js"
    },
    "./accounts": {
      "types": "./dist/accounts/index.d.ts",
      "import": "./dist/accounts/index.js"
    },
    "./resources": {
      "types": "./dist/resources/index.d.ts",
      "import": "./dist/resources/index.js"
    },
    "./resources/ui": {
      "types": "./dist/resources/ui.d.ts",
      "import": "./dist/resources/ui.js"
    },
    "./dev": {
      "types": "./dist/dev/index.d.ts",
      "import": "./dist/dev/index.js",
      "default": "./dist/dev/index.js"
    },
    "./dev/menu": {
      "types": "./dist/dev/menu.d.ts",
      "import": "./dist/dev/menu.js"
    },
    "./ribbon": {
      "types": "./dist/ribbon/index.d.ts",
      "import": "./dist/ribbon/index.js"
    },
    "./backdrops": {
      "types": "./dist/backdrops/index.d.ts",
      "import": "./dist/backdrops/index.js",
      "default": "./dist/backdrops/index.js"
    },
    "./backdrops/react": {
      "types": "./dist/backdrops/react.d.ts",
      "import": "./dist/backdrops/react.js"
    },
    "./backdrops/picker": {
      "types": "./dist/backdrops/picker.d.ts",
      "import": "./dist/backdrops/picker.js"
    },
    "./themes": {
      "types": "./dist/themes/index.d.ts",
      "import": "./dist/themes/index.js",
      "default": "./dist/themes/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "auth-kit": "./dist/bin/auth-kit.js"
  },
  "scripts": {
    "build": "tsup && tsup --config tsup.lambda.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "test:e2e": "AUTH_KIT_E2E=1 vitest run test/e2e",
    "demo:backdrops": "npm run build && node scripts/serve-docs.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1152.0",
    "@aws-sdk/client-dynamodb": "^3.1152.0",
    "@aws-sdk/client-sesv2": "^3.1152.0",
    "aws-jwt-verify": "^5.2.1"
  },
  "peerDependencies": {
    "@aws-amplify/backend": "^1.25.0",
    "aws-cdk-lib": "^2.257.0",
    "constructs": "^10.6.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "aws-amplify": "^6.22.0"
  },
  "peerDependenciesMeta": {
    "@aws-amplify/backend": {
      "optional": true
    },
    "aws-cdk-lib": {
      "optional": true
    },
    "constructs": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "aws-amplify": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-amplify/adapter-nextjs": "^1.8.1",
    "@aws-amplify/auth-construct": "^1.12.0",
    "@aws-amplify/backend": "^1.25.1",
    "@aws-amplify/backend-auth": "^1.10.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "aws-amplify": "^6.22.2",
    "aws-cdk-lib": "^2.273.0",
    "aws-sdk-client-mock": "^4.1.0",
    "constructs": "^10.8.1",
    "eslint": "^10.13.0",
    "jsdom": "^29.1.1",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
